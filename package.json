{
  "name": "wave-roll",
  "version": "0.4.0",
  "description": "JavaScript Library for Comparative MIDI Piano-Roll Visualization",
  "main": "dist/wave-roll.umd.js",
  "module": "dist/wave-roll.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wave-roll.es.js",
      "require": "./dist/wave-roll.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && bun run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,json,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,json,css}'",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crescent-stdio/wave-roll.git"
  },
  "keywords": [
    "midi",
    "piano-roll",
    "visualization",
    "music",
    "music-information-retrieval"
  ],
  "author": "Hannah Park",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "packageManager": "bun@1.3.14",
  "bugs": {
    "url": "https://github.com/crescent-stdio/wave-roll/issues"
  },
  "homepage": "https://github.com/crescent-stdio/wave-roll#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "d3-scale": "^4.0.2",
    "pixi.js": "^8.19.0",
    "tone": "^15.1.22"
  }
}
